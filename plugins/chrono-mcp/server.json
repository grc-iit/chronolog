{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.grc-iit/chronolog-mcp",
  "title": "ChronoLog MCP",
  "description": "Durable conversation logging, story management and Replay with explicit completeness.",
  "version": "4.0.0",
  "repository": {
    "url": "https://github.com/grc-iit/ChronoLog",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "chronolog-mcp",
      "version": "4.0.0",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "CHRONOLOG_CATALOG",
          "description": "Public ChronoLog Catalog endpoint",
          "default": "127.0.0.1:50051"
        },
        {
          "name": "CHRONOLOG_PLAYER",
          "description": "Optional public Replay endpoint"
        },
        {
          "name": "CHRONOLOG_CHRONICLE",
          "description": "Default chronicle",
          "default": "chronolog"
        },
        {
          "name": "CHRONOLOG_WRITER_IDENTITY",
          "description": "Optional writer identity"
        }
      ]
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "tools": [
        "start_chronolog",
        "record_interaction",
        "retrieve_interaction",
        "stop_chronolog",
        "list_stories",
        "create_story",
        "append",
        "read",
        "tail"
      ],
      "resources": [
        "chronolog://status"
      ],
      "prompts": [
        "logging_workflow"
      ]
    }
  }
}
